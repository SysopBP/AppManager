<io.github.muntashirakon.AppManager.widgets.GlassCoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="228dp"
    android:layout_margin="16dp">

    <io.github.muntashirakon.AppManager.widgets.WallpaperView
        android:id="@+id/sphere_wallpaper" android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:text="@string/sphere_theme_preview"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <io.github.muntashirakon.AppManager.widgets.GlassCardView
        android:layout_width="match_parent" android:layout_height="120dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="54dp"
        app:cardCornerRadius="24dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/sphere_theme_preview_body"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
    </io.github.muntashirakon.AppManager.widgets.GlassCardView>

    <LinearLayout android:id="@+id/appsphere_floating_bar"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="16dp"
        android:layout_gravity="bottom" android:elevation="6dp"
        android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/appsphere_nav_home" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:drawableTop="@drawable/ic_home_outlined"
            android:drawablePadding="3dp" android:paddingVertical="6dp"
            android:text="@string/appsphere_home_18" android:textSize="12sp" />
        <TextView android:id="@+id/appsphere_nav_apps" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:drawableTop="@drawable/ic_view_list"
            android:drawablePadding="3dp" android:paddingVertical="6dp"
            android:text="@string/appsphere_home_19" android:textSize="12sp" />
        <TextView android:id="@+id/appsphere_nav_settings" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="3dp" android:paddingVertical="6dp"
            android:text="@string/appsphere_home_22" android:textSize="12sp" />
    </LinearLayout>
</io.github.muntashirakon.AppManager.widgets.GlassCoordinatorLayout>
