<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0C12"
    tools:context="io.github.muntashirakon.AppManager.main.MainActivity">

    <io.github.muntashirakon.widget.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/item_list">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#D91C1A25"
            app:navigationIcon="@null"
            tools:menu="@menu/activity_main_actions" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_linear"
            style="@style/Widget.AppTheme.LinearProgressIndicator"
            android:indeterminate="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </io.github.muntashirakon.widget.AppBarLayout>

    <io.github.muntashirakon.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <io.github.muntashirakon.widget.RecyclerView
            android:id="@+id/item_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:focusable="false"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            android:paddingTop="6dp"
            android:fitsSystemWindows="true"
            app:fastScrollerEnabled="true"
            tools:listitem="@layout/item_main" />

    </io.github.muntashirakon.widget.SwipeRefreshLayout>

    <io.github.muntashirakon.widget.MultiSelectionView
        android:id="@+id/selection_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:focusable="false"
        app:menu="@menu/activity_main_selection_actions" />


    <!-- AppSphere dashboard: isolated from the existing RecyclerView and selection state. -->
    <ScrollView
        android:id="@+id/appsphere_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="96dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_1"
                android:textColor="#F8F5FF"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/appsphere_home_2"
                android:textColor="#BDB8CC"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/appsphere_glass_bar"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appsphere_home_3"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/appsphere_backend_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/appsphere_home_4"
                    android:textColor="#E4DFF1"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/appsphere_backend_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appsphere_home_5"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/appsphere_backend_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appsphere_home_6"
                    android:textAllCaps="false" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:text="@string/appsphere_home_7"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/appsphere_activity_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/appsphere_glass_bar"
                android:padding="16dp"
                android:text="@string/appsphere_home_8"
                android:textColor="#E4DFF1"
                android:textSize="14sp" />
            <Button
                android:id="@+id/appsphere_activity_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_9"
                android:textAllCaps="false" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/appsphere_glass_bar"
                android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/appsphere_home_10"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/appsphere_command_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_11"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_installer_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_12"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_command_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_13"
                android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/appsphere_glass_bar"
                android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/appsphere_home_14"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/appsphere_dashboard_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_15"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_dashboard_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_16"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_dashboard_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appsphere_home_17"
                android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- AppSphere: floating navigation, independent of the scrolling app list. -->
    <LinearLayout
        android:id="@+id/appsphere_floating_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/appsphere_glass_bar"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp">

        <Button
            android:id="@+id/appsphere_nav_home"
            style="?attr/borderlessButtonStyle"
            android:background="@drawable/appsphere_nav_item"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/appsphere_home_18"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_apps"
            style="?attr/borderlessButtonStyle"
            android:background="@drawable/appsphere_nav_item"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/appsphere_home_19"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_installer"
            style="?attr/borderlessButtonStyle"
            android:background="@drawable/appsphere_nav_item"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/appsphere_home_20"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_running"
            style="?attr/borderlessButtonStyle"
            android:background="@drawable/appsphere_nav_item"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/appsphere_home_21"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_settings"
            style="?attr/borderlessButtonStyle"
            android:background="@drawable/appsphere_nav_item"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/appsphere_home_22"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
