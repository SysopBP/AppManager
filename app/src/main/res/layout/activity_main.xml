<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0C12"
    tools:context="io.github.muntashirakon.AppManager.main.MainActivity">

    <io.github.muntashirakon.widget.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/item_list">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#D91C1A25"
            app:navigationIcon="@null"
            tools:menu="@menu/activity_main_actions" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_linear"
            style="@style/Widget.AppTheme.LinearProgressIndicator"
            android:indeterminate="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </io.github.muntashirakon.widget.AppBarLayout>

    <io.github.muntashirakon.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <io.github.muntashirakon.widget.RecyclerView
            android:id="@+id/item_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:focusable="false"
            android:clipToPadding="false"
            android:paddingBottom="144dp"
            android:paddingTop="6dp"
            android:fitsSystemWindows="true"
            app:fastScrollerEnabled="true"
            tools:listitem="@layout/item_main" />

    </io.github.muntashirakon.widget.SwipeRefreshLayout>

    <io.github.muntashirakon.widget.MultiSelectionView
        android:id="@+id/selection_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:focusable="false"
        app:menu="@menu/activity_main_selection_actions" />


    <!-- AppSphere dashboard: isolated from the existing RecyclerView and selection state. -->
    <ScrollView
        android:id="@+id/appsphere_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="104dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="140dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AppSphere"
                android:textColor="#F8F5FF"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:text="Device overview and quick controls"
                android:textColor="#BDB8CC"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/appsphere_glass_bar"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Backend control center"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/appsphere_backend_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Checking current session…"
                    android:textColor="#E4DFF1"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/appsphere_backend_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refresh status"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/appsphere_backend_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connection settings"
                    android:textAllCaps="false" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Live system activity"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/appsphere_activity_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/appsphere_glass_bar"
                android:padding="18dp"
                android:text="Tap refresh to read device memory and storage"
                android:textColor="#E4DFF1"
                android:textSize="14sp" />
            <Button
                android:id="@+id/appsphere_activity_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh device metrics"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Command center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/appsphere_command_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search installed apps"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_installer_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Installer Control · Experimental"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_command_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open tools and settings"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Quick access"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/appsphere_dashboard_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Browse installed apps"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_dashboard_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App filters and sorting"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/appsphere_dashboard_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Running applications"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

    <!-- AppSphere: floating navigation, independent of the scrolling app list. -->
    <LinearLayout
        android:id="@+id/appsphere_floating_bar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/appsphere_glass_bar"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/appsphere_nav_home"
            style="?attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="Home"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_apps"
            style="?attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="Apps"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_running"
            style="?attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="Running"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appsphere_nav_settings"
            style="?attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="Settings"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>