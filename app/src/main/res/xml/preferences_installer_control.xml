<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/sphere_routing_module" app:layout="@layout/m3_preference_category">
        <Preference app:icon="@drawable/sphere_ic_info" app:key="route_status" app:title="@string/sphere_routing_inactive" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_inactive_summary" />
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_permissions" app:key="routing_enabled" app:title="@string/sphere_routing_enable" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_enable_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/sphere_routing_general" app:layout="@layout/m3_preference_category">
        <Preference app:icon="@drawable/sphere_ic_installer" app:key="selected_installer_package" app:title="@string/sphere_routing_installer" app:iconSpaceReserved="true" app:persistent="false" />
        <Preference app:icon="@drawable/sphere_ic_tune" app:key="forced_activity" app:title="@string/sphere_routing_activity" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_activity_summary" />
        <Preference app:icon="@drawable/sphere_ic_tune" app:key="install_apk" app:title="@string/sphere_install_apk" app:iconSpaceReserved="true" app:persistent="false" />
        <Preference app:icon="@drawable/sphere_ic_installer" app:key="selected_uninstaller_package" app:title="@string/sphere_routing_uninstaller" app:iconSpaceReserved="true" app:persistent="false" />
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_installer" app:key="follow_uninstall_with_installer" app:title="@string/sphere_routing_follow" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_follow_summary" />
        <Preference app:icon="@drawable/sphere_ic_installer" app:key="advanced_installer" app:title="@string/sphere_installer_advanced" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_installer_advanced_summary" android:fragment="io.github.muntashirakon.AppManager.settings.InstallerPreferences" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/sphere_routing_system" app:layout="@layout/m3_preference_category">
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_installer" app:key="intercept_uninstall" app:title="@string/sphere_routing_intercept_uninstall" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_uninstall_summary" />
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_running" app:key="intercept_session_install" app:title="@string/sphere_routing_sessions" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_sessions_summary" />
        <Preference app:icon="@drawable/sphere_ic_tune" app:key="forced_sources" app:title="@string/sphere_routing_sources" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_sources_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/sphere_routing_experimental" app:layout="@layout/m3_preference_category">
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_permissions" app:key="fix_permissions" app:title="@string/sphere_routing_permissions" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_permissions_summary" />
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_tune" app:key="bypass_coloros_adb_intercept" app:title="@string/sphere_routing_coloros" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_coloros_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/sphere_routing_module" app:layout="@layout/m3_preference_category">
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_logs" app:key="enable_debug_log" app:title="@string/sphere_routing_logs" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_logs_summary" />
        <SwitchPreferenceCompat app:icon="@drawable/sphere_ic_apps" app:key="hide_launcher_icon" app:title="@string/sphere_routing_hide" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_hide_summary" />
        <Preference app:icon="@drawable/sphere_ic_updates" app:key="hot_reload" app:title="@string/sphere_routing_reload" app:iconSpaceReserved="true" app:persistent="false" app:summary="@string/sphere_routing_reload_summary" />
        <Preference app:icon="@drawable/sphere_ic_restore" app:key="reset_routes" app:title="@string/sphere_routing_reset" app:iconSpaceReserved="true" app:persistent="false" />
    </PreferenceCategory>
<Preference app:icon="@drawable/sphere_ic_info" app:key="inxlocker_credit" app:title="@string/sphere_routing_credit" app:summary="@string/sphere_routing_credit_summary" app:iconSpaceReserved="true" app:persistent="false" />
</PreferenceScreen>
