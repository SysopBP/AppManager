<!-- Some Android 17 loaders inflate state-list children with theme=null.
     Keep every nested drawable independent of theme attributes. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#406F6A80">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#406F6A80" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#00000000" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
