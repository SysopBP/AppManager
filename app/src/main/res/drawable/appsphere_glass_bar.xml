<!-- AppSphere One UI-inspired translucent navigation surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F0232229"
        android:centerColor="#EA1C1B22"
        android:endColor="#F0131218" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#465D5866" />
    <padding android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="4dp" />
</shape>
