<!-- AppSphere One UI-inspired translucent navigation surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#EE211F2A"
        android:centerColor="#E9282532"
        android:endColor="#F0191721" />
    <corners android:radius="32dp" />
    <stroke android:width="1dp" android:color="#70D8C7D8" />
    <padding android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="4dp" />
</shape>
