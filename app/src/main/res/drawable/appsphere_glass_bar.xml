<!-- AppSphere One UI-inspired translucent navigation surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D9282632"
        android:centerColor="#C822202D"
        android:endColor="#DF17151F" />
    <corners android:radius="32dp" />
    <stroke android:width="1dp" android:color="#80BEB7CF" />
    <padding android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="4dp" />
</shape>
